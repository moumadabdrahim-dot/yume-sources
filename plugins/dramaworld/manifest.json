        { "id": "latest-movies", "type": "movie", "title": "وصلت للتو", "capabilities": ["home", "browse", "pagination"], "filters": [], "homeOrder": 10, "homeFallback": true, "presentation": { "posterShape": "portrait" } },
        { "id": "latest-series", "type": "series", "title": "جديد الدراما", "capabilities": ["home", "browse", "pagination"], "filters": [], "homeOrder": 20, "homeFallback": true, "presentation": { "posterShape": "portrait" } },
        { "id": "top-imdb-movies", "type": "movie", "title": "روائع السينما", "capabilities": ["home", "browse", "pagination"], "filters": [], "homeOrder": 30, "homeFallback": true, "presentation": { "posterShape": "portrait" } },
        { "id": "top-imdb-series", "type": "series", "title": "دراما في القمة", "capabilities": ["home", "browse", "pagination"], "filters": [], "homeOrder": 40, "homeFallback": true, "presentation": { "posterShape": "portrait" } },
        { "id": "most-viewed-movies", "type": "movie", "title": "الأكثر مشاهدة", "capabilities": ["home", "browse", "pagination"], "filters": [], "homeOrder": 50, "homeFallback": true, "presentation": { "posterShape": "portrait" } },
        { "id": "current-year-movies", "type": "movie", "title": "سينما هذا العام", "capabilities": ["home", "browse", "pagination"], "filters": [], "homeOrder": 60, "homeFallback": true, "presentation": { "posterShape": "portrait" } },
        {
          "id": "discover-movies",
          "type": "movie",
          "title": "استكشاف الأفلام",
