          "discoverType": "movie",
          "filters": [
            { "key": "genre", "kind": "select", "label": "التصنيف", "dynamic": true, "dependsOn": ["year"], "discoverPresentation": { "priority": 10, "role": "genre" } },
            { "key": "order", "kind": "select", "label": "الترتيب", "dynamic": true, "dependsOn": ["year"], "discoverPresentation": { "priority": 20 } },
            { "key": "year", "kind": "select", "label": "السنة", "dynamic": true, "discoverPresentation": { "priority": 30 } }
          ],
          "homeFallback": false,
          "presentation": { "posterShape": "portrait" }
        },
        {
          "id": "discover-series",
          "type": "series",
          "title": "استكشاف المسلسلات",
          "capabilities": ["browse", "pagination"],
          "discoverType": "series",
          "filters": [
            { "key": "genre", "kind": "select", "label": "التصنيف", "dynamic": true, "dependsOn": ["year"], "discoverPresentation": { "priority": 10, "role": "genre" } },
            { "key": "order", "kind": "select", "label": "الترتيب", "dynamic": true, "dependsOn": ["year"], "discoverPresentation": { "priority": 20 } },
            { "key": "year", "kind": "select", "label": "السنة", "dynamic": true, "discoverPresentation": { "priority": 30 } }
